# Google Gmail Configuration (Simple - App Password)
GOOGLE_USER_EMAIL=your_email@gmail.com
GOOGLE_PASS_EMAIL=your_app_password_here

# Optional: Override the from email address
EMAIL_FROM=noreply@yourdomain.com

# Application URL (used in email links)
APP_URL=http://localhost:3000

# Database Configuration
# For development (local):
DATABASE_URL=postgres://postgres:your_password@localhost:5432/milk_logs

# For production (if using external host):
# DATABASE_URL=postgres://user:password@host:5432/milk_logs?sslmode=verify-full

# Environment
NODE_ENV=development

# Server Port
PORT=4000

# Other Configuration
JWT_ACCESS_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Gemini AI Assistant (get key from https://aistudio.google.com/apikey)
# Best for this simple assistant: gemini-3.5-flash-lite — highest RPM (15 free / 1000+ paid), lowest latency & cost, supports tool-calling
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

